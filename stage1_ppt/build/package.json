{
  "name": "parivaar-cover-deck",
  "version": "1.0.0",
  "description": "Builds the Stage 1 pitch deck (.pptx) and exports the submission PDF",
  "scripts": {
    "build": "node build_deck.js",
    "pdf": "rm -f ../Parivaar_Cover_Team_Prometheus.pdf && osascript export_pdf.applescript \"$PWD/../Parivaar_Cover_Team_Prometheus.pptx\" \"$PWD/../Parivaar_Cover_Team_Prometheus.pdf\" && ls -la ../Parivaar_Cover_Team_Prometheus.pdf",
    "all": "npm run build && npm run pdf"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5"
  },
  "private": true
}
