# Sarvam AI speech-to-text (server only, never exposed to the browser)
SARVAM_API_KEY=
# Optional overrides. Defaults: model saaras:v4, mode transcribe, language auto-detect.
SARVAM_STT_MODEL=
SARVAM_STT_MODE=
SARVAM_STT_LANGUAGE=
# Text-to-speech (replies read aloud). Defaults: Sarvam's default Bulbul model and voice.
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=

# Backend base URL. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=
