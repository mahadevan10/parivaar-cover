# Sarvam AI speech-to-text (server only, never exposed to the browser)
SARVAM_API_KEY=
# Optional overrides. Defaults: model saaras:v4, mode transcribe, language auto-detect.
SARVAM_STT_MODEL=
SARVAM_STT_MODE=
SARVAM_STT_LANGUAGE=

# Backend base URL, e.g. http://localhost:8000. Leave empty to use the built-in mock.
NEXT_PUBLIC_API_BASE_URL=
